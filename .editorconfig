# EditorConfig: https://editorconfig.org
# Mirrors kotlin.code.style=official and Android/Gradle conventions used in this repo.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{gradle,groovy}]
indent_size = 4
max_line_length = 120

[*.{xml,html}]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
