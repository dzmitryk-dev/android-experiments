# Normalize line endings to LF; ensure scripts are executable on checkout.
* text=auto eol=lf

# Gradle wrapper scripts must keep CRLF on Windows and stay executable everywhere.
gradlew.bat text eol=crlf
gradlew     text eol=lf

# Force LF for shell/sh and Groovy/Kotlin build scripts.
*.sh        text eol=lf
*.gradle    text eol=lf
*.gradle.kts text eol=lf
*.kts       text eol=lf

# Binary / large files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.aar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
*.zip binary
*.pdf binary

# Linguist overrides — keep generated/vendor files out of language stats.
.gitignore          linguist-generated=true
.idea/**            linguist-vendored=true
build/**            linguist-vendored=true
**/build/**         linguist-vendored=true
*.pro               linguist-vendored=true
